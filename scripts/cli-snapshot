#!/usr/bin/env python3
# SPDX-License-Identifier: Apache-2.0
# usage: cli-snapshot NVME_BIN OUTDIR: metadata.json and help.txt (the --help
# of every command) of a build; diff two snapshots to review CLI changes
import json, os, subprocess, sys
if len(sys.argv) != 3 or sys.argv[1] in ('-h', '--help'):
    sys.exit('usage: cli-snapshot NVME_BIN OUTDIR')
nvme, out = sys.argv[1], sys.argv[2]
os.makedirs(out, exist_ok=True)
meta = subprocess.run([nvme, 'utils', 'dump-command-metadata'], capture_output=True, text=True).stdout
open(os.path.join(out, 'metadata.json'), 'w').write(meta)
d = json.loads(meta)
cmds = [([c['name']], c) for c in d['commands']]
for p in d['plugins']:
    cmds += [([p['name'], c['name']], c) for c in p.get('commands', [])]
with open(os.path.join(out, 'help.txt'), 'w') as f:
    for argv, _ in cmds:
        r = subprocess.run([nvme] + argv + ['--help'], capture_output=True, text=True, stdin=subprocess.DEVNULL, timeout=20)
        f.write(f'===== {" ".join(argv)} rc={r.returncode}\n{r.stdout}--- stderr\n{r.stderr}')
print(len(cmds), 'commands')
