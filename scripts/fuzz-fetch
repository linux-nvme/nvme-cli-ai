#!/bin/bash
# SPDX-License-Identifier: Apache-2.0
# usage: fuzz-fetch [-t TARGET] [-n SRC] [-r RESULTS] HOST LOCAL_DIR [SSH_OPTION...]
#        fuzz-fetch -s [-t TARGET] [-n SRC] [-b BUILD] [-r RESULTS] HOST [SSH_OPTION...]
#
# Copy the findings of a scripts/fuzz/nvme-fuzz run on HOST (user@host,
# as for ssh) to LOCAL_DIR: the files of RESULTS/artifacts/TARGET, which
# LOCAL_DIR does not have yet. SRC is the nvme-cli tree on HOST
# (nvme-cli, relative to the home directory), RESULTS the --results of
# the run (SRC/.build-fuzz/fuzz), TARGET defaults to device. Each file is
# checked against the SHA-1 at the end of its name. Prints the new files;
# then triage them:
#
#   fuzz-fetch -n /root/nvme-cli -r /root/fuzz-results root@box /tmp/f -4
#   scripts/fuzz/nvme-fuzz -C .build-fuzz triage /tmp/f
#
# -s instead triages every finding on HOST with nvme-fuzz triage of SRC
# and the fuzz build BUILD (SRC/.build-fuzz): which bugs the run found,
# before copying anything.
#
# Copies with ssh and tar: scp stalls on some hosts and flattens
# directories. SSH_OPTIONs go to ssh as they are, e.g. -4 when IPv6
# connections to HOST hang.
set -u
T=device
S=nvme-cli
R=
B=
summary=
usage() { sed -n '3,24s/^# \?//p' "$0"; exit 2; }
while getopts :st:n:r:b: o; do
	case $o in
	s) summary=1 ;;
	t) T=$OPTARG ;;
	n) S=$OPTARG ;;
	r) R=$OPTARG ;;
	b) B=$OPTARG ;;
	*) usage ;;
	esac
done
shift $((OPTIND - 1))
R=${R:-$S/.build-fuzz/fuzz}
B=${B:-$S/.build-fuzz}

ssh_run() {
	timeout 900 ssh -o BatchMode=yes -o ConnectTimeout=20 "$@"
}

if [ -n "$summary" ]; then
	[ $# -ge 1 ] || usage
	host=$1
	shift
	# from /tmp: older versions of nvme-fuzz replay in the current
	# directory, which collects the crash-* files of the inputs
	ssh_run "$@" "$host" "s=\$(cd '$S' && pwd) &&
		b=\$(cd '$B' && pwd) && r=\$(cd '$R' && pwd) && cd /tmp &&
		\$s/scripts/fuzz/nvme-fuzz -C \$b triage --target '$T' \$r/artifacts/'$T'"
	exit
fi

[ $# -ge 2 ] || usage
host=$1 dir=$2
shift 2

mkdir -p "$dir" || exit 1
remote=$(ssh_run "$@" "$host" "ls '$R/artifacts/$T'") || {
	echo "cannot list $host:$R/artifacts/$T" >&2
	exit 1
}

want=()
for f in $remote; do
	[ -e "$dir/$f" ] || want+=("$f")
done
[ ${#want[@]} -gt 0 ] || { echo "no new findings" >&2; exit 0; }

ssh_run "$@" "$host" "cd '$R/artifacts/$T' && tar cf - ${want[*]}" |
	tar xf - -C "$dir" || { echo "copy failed" >&2; exit 1; }

bad=0
for f in "${want[@]}"; do
	sum=$(sha1sum < "$dir/$f" | cut -c1-40)
	# crash-<sha1>, data-<limit>-crash-<sha1>, ...
	if [ "${f##*-}" != "$sum" ]; then
		echo "BAD   $f (sha1 $sum)" >&2
		bad=1
	else
		echo "$dir/$f"
	fi
done
exit $bad
